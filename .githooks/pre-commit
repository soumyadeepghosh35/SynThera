#!/usr/bin/env python3
"""Git pre-commit hook that keeps oversized files out of the commit.

Any staged file larger than the size limit is unstaged automatically and added
to .gitignore, then the commit proceeds with the remaining files. This protects
the repository from files that exceed hosting limits or bloat the history.
"""

import subprocess
import sys
from pathlib import Path

SIZE_LIMIT_MB = 50
SIZE_LIMIT_BYTES = SIZE_LIMIT_MB * 1024 * 1024
GITIGNORE_PATH = Path(".gitignore")


def stagedFiles():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        check=True,
        capture_output=True,
        text=True,
    )
    return [line for line in result.stdout.splitlines() if line.strip()]


def fileSizeBytes(path):
    try:
        return Path(path).stat().st_size
    except OSError:
        return 0


def unstageFile(path):
    subprocess.run(
        ["git", "rm", "--cached", "--ignore-unmatch", path],
        check=True,
        capture_output=True,
        text=True,
    )


def addToGitignore(paths):
    currentText = GITIGNORE_PATH.read_text() if GITIGNORE_PATH.is_file() else ""
    existing = set(currentText.splitlines())
    newEntries = [path for path in paths if path not in existing]
    if not newEntries:
        return
    prefix = "" if currentText == "" or currentText.endswith("\n") else "\n"
    with GITIGNORE_PATH.open("a") as handle:
        handle.write(prefix)
        for entry in newEntries:
            handle.write(f"{entry}\n")
    subprocess.run(
        ["git", "add", ".gitignore"], check=True, capture_output=True, text=True
    )


def main():
    oversized = [
        path for path in stagedFiles() if fileSizeBytes(path) > SIZE_LIMIT_BYTES
    ]
    if not oversized:
        return 0

    print(f"Removing files larger than {SIZE_LIMIT_MB} MB from this commit:")
    for path in oversized:
        sizeMb = fileSizeBytes(path) / (1024 * 1024)
        print(f"  {path} ({sizeMb:.1f} MB)")
        unstageFile(path)

    addToGitignore(oversized)
    print(
        "These files were unstaged and added to .gitignore, so the commit will "
        "continue without them. Use Git LFS if you need to version large files."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())

